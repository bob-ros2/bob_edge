# ROS 2 Network Configuration
ROS_DOMAIN_ID=55

# Orchestrator API Configuration (Gateway or Direct LLM API)
ORCHESTRATOR_API_KEY="injected_by_gateway_proxy"
ORCHESTRATOR_API_URL="http://api-gateway:8080/v1"

# Model Selection
ORCHESTRATOR_MODEL_CHAT="deepseek-v4-flash"
ORCHESTRATOR_MODEL_REASONER="deepseek-reasoner"

# Orchestrator Behavior
ORCHESTRATOR_REJECT_IF_BUSY=true
ORCHESTRATOR_ENABLE_QUEUING=false
ORCHESTRATOR_REJECT_MSG="The agent is currently busy. Please wait a moment."

# Search Service Configuration (e.g., SearXNG)
MASTER_SEARXNG_URL="http://api-gateway:8080/search"
MASTER_SEARXNG_LANGUAGE="en-US"

# -- BACKEND SERVICE URLs --
UPSTREAM_API_URL="https://api.deepseek.com/v1/"
COUCHDB_URL="http://agent-couchdb:5984"
SEARXNG_URL="http://192.168.1.10:9080"

# Hermes Agent Configuration
HERMES_MODEL="gemma-4-26B-A4B-it-UD"
HERMES_BASE_URL="http://192.168.1.9:8022/v1"
HERMES_API_KEY="dummy_token"

CRAWL4AI_BASE_URL=http://192.168.1.10:3020
CRAWL4AI_API_KEY=local_instance
