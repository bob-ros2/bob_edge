# Bob Edge - ROS 2 Bash Configuration

# Source ROS 2 Base
if [ -f "/opt/ros/${ROS_DISTRO}/setup.bash" ]; then
    source "/opt/ros/${ROS_DISTRO}/setup.bash"
fi

# Source Workspace (if built)
if [ -f "/ros2_ws/install/setup.bash" ]; then
    source "/ros2_ws/install/setup.bash"
fi

# Color Prompt
export PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# Aliases
alias l='ls -CF'
alias la='ls -A'
alias ll='ls -alF'
alias ls='ls --color=auto'
alias rt='ros2 topic list'
alias rn='ros2 node list'
alias test_agent='python3 -m pytest /ros2_ws/src/bob_edge/tests/test_repo.py'

alias chat='ros2 run bob_llm chat \
--topic_in /agent/user_query \
--topic_out /agent/llm_stream \
--topic_response /agent/logic/internal/full_response_text \
--topic_tools /agent/llm_tool_calls \
--topic_reasoning /agent/llm_reasoning'
