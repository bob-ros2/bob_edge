# Use the existing base image which has ROS 2 and all dependencies built.
ARG BASE_IMAGE=ghcr.io/bob-ros2/bob-edge:latest
FROM ${BASE_IMAGE}

USER root

# Install system dependencies for OpenCV, GUI tools, and RKNN Runtime
RUN apt-get update && apt-get install -y \
    python3-opencv \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libxslt1-dev \
    zlib1g-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Download and install RKNPU2 runtime library (librknnrt.so) for RK3588 matching driver v0.9.3
RUN curl -L -o /usr/lib/librknnrt.so https://github.com/airockchip/rknpu2/raw/v1.6.0/runtime/RK3588/Linux/librknn_api/aarch64/librknnrt.so

# Download and install RKNN Toolkit Lite 2 python wheel directly using the corrected folder path (with underscores)
RUN curl -L -o /tmp/rknn_toolkit_lite2-1.6.0-cp310-cp310-linux_aarch64.whl https://github.com/airockchip/rknn-toolkit2/raw/v1.6.0/rknn_toolkit_lite2/packages/rknn_toolkit_lite2-1.6.0-cp310-cp310-linux_aarch64.whl && \
    pip3 install --no-cache-dir /tmp/rknn_toolkit_lite2-1.6.0-cp310-cp310-linux_aarch64.whl && \
    rm /tmp/rknn_toolkit_lite2-1.6.0-cp310-cp310-linux_aarch64.whl

# Install Flask and Pillow for the simple HTTP MJPEG stream
RUN pip3 install --no-cache-dir flask pillow

# Build the workspace for the new yolov8_npu node
WORKDIR /ros2_ws
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --symlink-install --packages-select bob_edge \
    --event-handlers console_direct+

# Secure permissions
RUN chown -R root:root /ros2_ws

USER rosuser
WORKDIR /home/rosuser

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["ros2", "run", "bob_edge", "yolov8_npu"]
