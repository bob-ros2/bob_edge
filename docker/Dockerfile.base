ARG ROS_DISTRO=humble
FROM ros:${ROS_DISTRO}-ros-base

# -- Build the Workspace --
ARG CACHE_BUST=1

RUN apt-get update && apt-get install -y \
    python3-pip \
    vim \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws

RUN echo "Cache bust: $CACHE_BUST" && \
    git clone https://github.com/bob-ros2/bob_llm /ros2_ws/src/bob_llm && \
    if [ -f /ros2_ws/src/bob_llm/requirements.txt ]; then pip3 install --no-cache-dir -r /ros2_ws/src/bob_llm/requirements.txt; fi

RUN echo "Cache bust: $CACHE_BUST" && \
    git clone https://github.com/bob-ros2/bob_launch /ros2_ws/src/bob_launch && \
    if [ -f /ros2_ws/src/bob_launch/requirements.txt ]; then pip3 install --no-cache-dir -r /ros2_ws/src/bob_launch/requirements.txt; fi

# Copy current local repo into workspace
COPY . /ros2_ws/src/bob_edge

RUN if [ -f /ros2_ws/src/bob_edge/requirements.txt ]; then pip3 install --no-cache-dir -r /ros2_ws/src/bob_edge/requirements.txt; fi

# Clean and Build (Force clean to avoid symlink/copy mismatches)
RUN rm -rf /ros2_ws/build /ros2_ws/install /ros2_ws/log && \
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --symlink-install --packages-select bob_llm bob_launch bob_edge \
    --event-handlers console_direct+

# Create rosuser (UID 1000 to match typical Synology default user)
RUN useradd -m -u 1000 -s /bin/bash rosuser

# Secure the workspace - root owns everything, rosuser can only read/execute
RUN chown -R root:root /ros2_ws

# Deploy BashRC
COPY ./config/_bashrc /root/.bashrc
COPY ./config/_bashrc /home/rosuser/.bashrc
RUN chown rosuser:rosuser /home/rosuser/.bashrc

# Entrypoint
RUN echo "#!/bin/bash\nsource /opt/ros/\${ROS_DISTRO}/setup.bash\nsource /ros2_ws/install/setup.bash\nexec \"\$@\"" > /ros_entrypoint.sh \
    && chmod +x /ros_entrypoint.sh

# Switch to the new non-root user
USER rosuser

ENTRYPOINT ["/ros_entrypoint.sh"]

# Use bob_launch to orchestrate the YAML configuration
CMD ["ros2", "launch", "bob_launch", "generic.launch.py", "config:=/ros2_ws/src/bob_edge/launch/base_launch.yaml"]
